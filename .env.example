# Leave STRIPE_SECRET_KEY empty to run in demo mode (fake sales).
# Use a RESTRICTED key with only "Charges: Read" permission:
# https://dashboard.stripe.com/apikeys -> Create restricted key
STRIPE_SECRET_KEY=

# Required in production when a Stripe key is set: the globe only streams
# real sales to URLs that carry ?key=<GLOBE_TOKEN>. Use a long random string.
GLOBE_TOKEN=

# Set to "false" to never send amounts to the browser (dots + sale count only).
SHOW_AMOUNTS=true

# Optional "lat,lng" of your HQ: every sale draws an arc to it.
KACHING_HQ=
